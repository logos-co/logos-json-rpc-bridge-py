#!/bin/sh
# Runs a nix command against local checkouts: one --override-input per variable set
# below (none by default), and exit 1 if nix reports an override that matched no input.
#
#   LOGOS_DEV_BRIDGE=path:$HOME/src/logos-json-rpc-bridge \
#     scripts/dev-overrides nix build .#checks.aarch64-darwin.integration -L
#   scripts/dev-overrides --print        the flags, one per line
#
# Each takes a flake URL (path:DIR, git+file://DIR, github:OWNER/REPO/REF). This flake's
# input of the same name follows each nested one, so the override reaches it too.
#   LOGOS_DEV_BRIDGE          logos-json-rpc-bridge
#   LOGOS_DEV_LIDL            logos-json-rpc-bridge/logos-lidl
#   LOGOS_DEV_PACKAGE         logos-json-rpc-bridge/logos-package
#   LOGOS_DEV_TEST_MODULES    logos-test-modules
#   LOGOS_DEV_LOGOSCORE_CLI   logos-test-modules/logos-logoscore-cli
#   LOGOS_DEV_LOGOSCORE_PY    logos-logoscore-py
set -eu

# An override never writes the lock: commit only a lock written without one.
flags() {
  n=0
  for pair in \
    "logos-json-rpc-bridge=${LOGOS_DEV_BRIDGE-}" \
    "logos-json-rpc-bridge/logos-lidl=${LOGOS_DEV_LIDL-}" \
    "logos-json-rpc-bridge/logos-package=${LOGOS_DEV_PACKAGE-}" \
    "logos-test-modules=${LOGOS_DEV_TEST_MODULES-}" \
    "logos-test-modules/logos-logoscore-cli=${LOGOS_DEV_LOGOSCORE_CLI-}" \
    "logos-logoscore-py=${LOGOS_DEV_LOGOSCORE_PY-}"
  do
    url=${pair#*=}
    [ -n "$url" ] || continue
    printf '%s\n' --override-input "${pair%%=*}" "$url"
    n=$((n + 1))
  done
  [ "$n" -eq 0 ] || printf '%s\n' --no-write-lock-file
}

if [ "$#" -eq 0 ]; then
  echo "usage: $0 nix <command> ... | --print" >&2
  exit 2
fi
if [ "$1" = --print ]; then
  flags
  exit 0
fi
if [ "$1" != nix ] || [ "$#" -lt 2 ]; then
  echo "dev-overrides: expected a nix command, got: $*" >&2
  exit 2
fi

# argv becomes: nix <command> [<subcommand>] <flags> <rest>, so `nix run ... -- args` keeps its args.
head=2
[ "$2" = flake ] && head=3
[ "$#" -ge "$head" ] || { echo "dev-overrides: incomplete nix command: $*" >&2; exit 2; }
lines=$(flags)
[ -n "$lines" ] || echo "dev-overrides: no LOGOS_DEV_* variable set; using the locked inputs" >&2
i=0
set -f
for arg in "$@"; do
  i=$((i + 1))
  set -- "$@" "$arg"
  if [ "$i" -eq "$head" ]; then
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086 # split on newlines only; no flag contains one
    set -- "$@" $lines
    IFS=$old_ifs
  fi
done
set +f
shift "$i"

work=$(mktemp -d "${TMPDIR:-/tmp}/dev-overrides.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# stdout passes through; stderr is shown and kept, to look for override warnings.
run() {
  if "$@"; then echo 0 > "$work/status"; else echo "$?" > "$work/status"; fi
}
{ run "$@" 2>&1 1>&3 3>&- | tee "$work/stderr" 1>&2 3>&-; } 3>&1
status=$(cat "$work/status" 2>/dev/null || echo 1)
if grep -E "does not match any input|has an override for a non-existent input" "$work/stderr" >/dev/null; then
  echo "dev-overrides: an override matched no input (see the warning above); failing" >&2
  [ "$status" -ne 0 ] || status=1
fi
exit "$status"
