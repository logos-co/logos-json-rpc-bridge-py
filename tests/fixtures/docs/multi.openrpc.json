    "schemas": {
      "Bytes": {
        "additionalProperties": false,
        "description": "A LIDL bstr: the bytes as base64url without padding (RFC 4648 section 5), carried as the object's only key. Do not name a map key \"_bytes\".",
        "properties": {
          "_bytes": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          }
        },
        "required": [
          "_bytes"
        ],
        "title": "Bytes",
        "type": "object"
      },
      "LogosResult": {
        "description": "A LIDL result. A provider that ran and failed answers success=false here: an application failure is a successful call, never a JSON-RPC error.",
        "properties": {
          "error": {
            "description": "The failure message as a string; null when there is none."
          },
          "success": {
            "type": "boolean"
          },
          "value": {
            "description": "The payload; any JSON value, null when absent."
          }
        },
        "required": [
          "success"
        ],
        "title": "LogosResult",
        "type": "object"
      },
      "ProviderRejection": {
        "additionalProperties": false,
        "description": "The provider refused the call and said why. It arrives as the call's result, not as a JSON-RPC error.",
        "properties": {
          "code": {
            "description": "Known codes: dispatch_failed (the argument values were refused), invalid_args (wrong argument count), unknown_method (reserved; not emitted yet). Treat any other code as a refusal too.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "origin": {
            "description": "The module that refused.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "origin"
        ],
        "title": "ProviderRejection",
        "type": "object"
      },
      "mini_module.Note": {
        "properties": {
          "body": {
            "$ref": "#/components/schemas/Bytes"
          },
