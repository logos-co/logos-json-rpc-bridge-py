    "/modules/mini_module/find": {
      "post": {
        "description": "Look a note up. An unknown id is success=false, not an error.",
        "operationId": "mini_module.find",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "prefix": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "type": "object"
                  },
                  {
                    "items": false,
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    ],
                    "type": "array"
                  }
                ]
              }
            }
          },
          "description": "The parameters, by name (an object) or by position (an array of exactly the declared arity, null for an empty optional slot).",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "result": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/LogosResult"
                            },
                            {
                              "$ref": "#/components/schemas/ProviderRejection"
                            }
                          ]
                        }
                      },
                      "required": [
                        "result"
                      ],
                      "type": "object"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorBody"
                    },
                    {
                      "$ref": "#/components/schemas/JsonRpcErrorResponse"
                    }
                  ]
                }
              }
            },
            "description": "The call's outcome: the method's value (or a ProviderRejection), or a JSON-RPC error."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "411": {
            "$ref": "#/components/responses/LengthRequired"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        },
        "summary": "Look a note up.",
        "tags": [
          "mini_module"
        ],
        "x-logos-method": "find",
        "x-logos-module": "mini_module"
      }
    },
