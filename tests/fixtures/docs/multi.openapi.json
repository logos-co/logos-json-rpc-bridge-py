{
  "components": {
    "requestBodies": {
      "NoParams": {
        "content": {
          "application/json": {
            "schema": {
              "description": "No parameters: an empty object or an empty array.",
              "oneOf": [
                {
                  "maxProperties": 0,
                  "type": "object"
                },
                {
                  "maxItems": 0,
                  "type": "array"
                }
              ],
              "title": "NoParams"
            }
          }
        },
        "description": "No parameters: send no body, {} or [].",
        "required": false
      },
      "UntypedParams": {
        "content": {
          "application/json": {
            "schema": {}
          }
        },
        "description": "Untyped: the parameters by name (an object) or by position (an array).",
        "required": false
      }
    },
    "responses": {
      "Forbidden": {
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": "Refused before routing: the Host header is not a loopback literal this bridge bound, or the Origin is not in http.allowed_origins."
      },
      "LengthRequired": {
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": "The request states no valid Content-Length, or has a Transfer-Encoding: the bridge reads no chunked body. The connection is closed."
      },
      "Unauthorized": {
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": "auth.mode is bearer and the request carries no valid `Authorization: Bearer` token."
      },
      "UnsupportedMediaType": {
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        },
        "description": "The Content-Type is not application/json, which is required even for an empty body."
      },
      "UntypedCallResult": {
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "result": {}
                  },
                  "required": [
                    "result"
                  ],
                  "type": "object"
                },
                {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                {
                  "$ref": "#/components/schemas/JsonRpcErrorResponse"
                }
              ]
            }
          }
        },
        "description": "The call's outcome: the method's value (or a ProviderRejection), or a JSON-RPC error."
      }
    },
    "schemas": {
      "Bytes": {
        "additionalProperties": false,
        "description": "A LIDL bstr: the bytes as base64url without padding (RFC 4648 section 5), carried as the object's only key. Do not name a map key \"_bytes\".",
        "properties": {
          "_bytes": {
            "pattern": "^[A-Za-z0-9_-]*$",
            "type": "string"
          }
        },
        "required": [
          "_bytes"
        ],
        "title": "Bytes",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "A module route's refusal: the JSON-RPC error alone. Denied, unexposed and unknown targets all get the same -32601.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/JsonRpcError"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "JsonRpcError": {
        "description": "A JSON-RPC 2.0 error object, with the Logos error taxonomy in data.",
        "properties": {
          "code": {
            "type": "integer"
          },
          "data": {
            "properties": {
              "invalid_params_detail": {
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "reason": {
                    "description": "schema-mismatch, malformed-cbor or non-deterministic-cbor.",
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "type": "object"
              },
              "logos_error_code": {
                "type": "integer"
              },
              "logos_error_name": {
                "type": "string"
              }
            },
            "required": [
              "logos_error_code",
              "logos_error_name"
            ],
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "JsonRpcError",
        "type": "object"
      },
      "JsonRpcErrorResponse": {
        "additionalProperties": false,
        "description": "A complete JSON-RPC 2.0 error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/JsonRpcError"
          },
          "id": {
            "$ref": "#/components/schemas/JsonRpcId"
          },
          "jsonrpc": {
            "const": "2.0"
          }
        },
        "required": [
          "jsonrpc",
          "id",
          "error"
        ],
        "title": "JsonRpcErrorResponse",
        "type": "object"
      },
      "JsonRpcId": {
        "description": "A JSON-RPC request id; a reply echoes it.",
        "title": "JsonRpcId",
        "type": [
          "string",
          "number",
          "null"
        ]
      },
      "LogosResult": {
        "description": "A LIDL result. A provider that ran and failed answers success=false here: an application failure is a successful call, never a JSON-RPC error.",
        "properties": {
          "error": {
            "description": "The failure message as a string; null when there is none."
          },
          "success": {
            "type": "boolean"
          },
          "value": {
            "description": "The payload; any JSON value, null when absent."
          }
        },
        "required": [
          "success"
        ],
        "title": "LogosResult",
        "type": "object"
      },
      "ProviderRejection": {
        "additionalProperties": false,
        "description": "The provider refused the call and said why. It arrives as the call's result, not as a JSON-RPC error.",
        "properties": {
          "code": {
            "description": "Known codes: dispatch_failed (the argument values were refused), invalid_args (wrong argument count), unknown_method (reserved; not emitted yet). Treat any other code as a refusal too.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "origin": {
            "description": "The module that refused.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "origin"
        ],
        "title": "ProviderRejection",
        "type": "object"
      },
      "mini_module.Note": {
        "properties": {
          "body": {
            "$ref": "#/components/schemas/Bytes"
          },
          "id": {
            "type": "string"
          },
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "body"
        ],
        "title": "Note",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The HTTP surface of the Logos JSON-RPC bridge. `POST /modules/<module>/<method>` calls an exposed module method with its parameters as the body, typed from the module's canonical LIDL contract when it has one (x-logos-untyped marks names-only modules). `POST /rpc` speaks JSON-RPC 2.0 (see rpc.discover). Every route checks Host and Origin and sends no CORS headers. A refusal (401, 403, 411, 415) leaves the request body unread, so when the request declares a body the connection closes after the refusal. Operations cover what this bridge lets you call; component schemas cover every record in each contract, and x-logos-modules gives each module's status, digests and exposure.",
    "title": "Logos JSON-RPC bridge",
    "version": "0.1.0"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.1",
  "paths": {
    "/asyncapi.json": {
      "get": {
        "description": "The AsyncAPI 3.0.0 description of this bridge's WebSocket endpoint.",
        "operationId": "getAsyncApi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The AsyncAPI document."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "The WebSocket description.",
        "tags": [
          "bridge"
        ],
        "x-logos-bridge-op": true
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness and draining state. Gated like every other route.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "protocol": {
                      "const": "json-rpc-2.0"
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "draining"
                      ],
                      "type": "string"
                    },
                    "uptime_seconds": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "uptime_seconds",
                    "protocol"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The bridge is serving."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "Bridge health.",
        "tags": [
          "bridge"
        ],
        "x-logos-bridge-op": true
      }
    },
    "/modules": {
      "get": {
        "description": "The rpc.list_modules views, in configuration order, without `interface`.",
        "operationId": "listModules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "description": "The bridge's view of one module, without `interface`.",
                    "properties": {
                      "authoritative": {
                        "type": "boolean"
                      },
                      "contract_sha256": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cross_check": {
                        "type": [
                          "object",
                          "null"
                        ]
                      },
                      "exposure": {
                        "properties": {
                          "events": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "methods": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "interface_error": {
                        "type": "string"
                      },
                      "interface_sha256": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "interface_status": {
                        "enum": [
                          "pending",
                          "ok",
                          "untyped",
                          "invalid"
                        ],
                        "type": "string"
                      },
                      "module": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "module"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The module views."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "Describe every exposed module.",
        "tags": [
          "bridge"
        ],
        "x-logos-bridge-op": true
      }
    },
    "/modules/broken_module/lidl": {
      "post": {
        "description": "Untyped: the module's lidl() contract was refused (see interface_error in x-logos-modules), so only names are known.\n\nBuilt-in: always callable for an exposed module, whatever this bridge's method policy.",
        "operationId": "broken_module.lidl",
