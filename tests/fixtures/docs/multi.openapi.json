    "/modules/mini_module/put": {
      "post": {
        "description": "Store a note and return it as stored.\n\n```json\n{\"id\": \"n1\", \"body\": {\"_bytes\": \"aGk\"}}\n```",
        "operationId": "mini_module.put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
